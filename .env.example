DATABASE_URL=postgres://localhost/ourtaiko_fanmade?host=/tmp&sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
APP_ORIGIN=http://127.0.0.1:5173
STORAGE_DIR=.data/files
COOKIE_SECURE=false

# SMTP uses STARTTLS with certificate verification and AUTH LOGIN.
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_USERNAME=smtp-user@example.com
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@mail.ourtaiko.org
SMTP_FROM_NAME=OurTaiko
