DATABASE_URL=postgres://localhost/ourtaiko_fanmade_sso_dev?host=/tmp&sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
APP_ORIGIN=http://127.0.0.1:5173
STORAGE_DIR=.data/sso-files
COOKIE_SECURE=false
# Set only behind a proxy that overwrites X-Real-IP. Empty ignores forwarded IPs.
TRUSTED_PROXY_CIDRS=
SSO_ISSUER=http://127.0.0.1:8090
# Optional Docker TCP route, e.g. sso:8090. Does not change issuer/Host/TLS checks.
SSO_CONNECT_ADDRESS=
SSO_SERVICE_ID=fanmade
SSO_SERVICE_KEY=
SSO_CLIENT_ID=ourtaiko-fanmade-web
SSO_CLIENT_SECRET=
SSO_REDIRECT_URL=http://127.0.0.1:5173/api/v1/auth/sso/callback
# Generate once with openssl rand -hex 32. Keep stable across restarts/replicas.
SESSION_ENCRYPTION_KEY=
# For an existing database: back it up and import all users into SSO first.
SSO_MIGRATION_BACKUP_CONFIRMED=false

# Permanent resource storage; STORAGE_DIR remains temporary upload staging in S3 mode.
STORAGE_BACKEND=local
S3_BUCKET=
AWS_REGION=
S3_PREFIX=
# S3 mode uses the AWS SDK credential chain (prefer a role; otherwise root-only env).
# Never commit AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY.
# Disable browser sessions/mutations for a game-only isolated test deployment.
GAME_ONLY=false
