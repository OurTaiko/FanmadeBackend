# Root-only configuration; AWS credentials are read from docker/storage.env.
BACKUP_DATABASE=ourtaiko_fanmade
BACKUP_POSTGRES_CONTAINER=ourtaiko-postgres
BACKUP_POSTGRES_USER=postgres
BACKUP_DIRECTORY=/var/backups/ourtaiko-fanmade/daily
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENABLED=true
BACKUP_S3_PREFIX=fanmade/backups/postgresql
