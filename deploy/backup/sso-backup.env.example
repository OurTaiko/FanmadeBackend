# Root-only override; credentials come from the SSO environment file.
BACKUP_DATABASE=ourtaiko_sso
BACKUP_POSTGRES_CONTAINER=ourtaiko-postgres
BACKUP_POSTGRES_USER=postgres
BACKUP_DIRECTORY=/var/backups/ourtaiko-sso/daily
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENABLED=true
BACKUP_S3_PREFIX=sso/backups/postgresql
S3_BUCKET=REPLACE_WITH_PRIVATE_BACKUP_BUCKET
